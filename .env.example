# Telegram
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
ADMIN_ID=123456789

# SSH
SSH_DEFAULT_USER=root
SSH_KEY_PATH=/root/.ssh/id_rsa
SSH_PORT=2222
# Used to encrypt SSH keys/passwords stored in SQLite. Set to a long random value.
MASTER_SECRET_KEY=

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Должен быть публичным и HTTPS (Cloudflare Tunnel / Nginx+SSL / ngrok)
WEB_APP_URL=https://your-domain.example
# Опционально: версия фронтенда для принудительного сброса Telegram-кэша (например 2026-05-24-1)
WEB_APP_VERSION=

# Marzban
# Если Marzban запущен на хосте (а Control Tower в Docker), используйте host.docker.internal:
MARZBAN_URL=http://host.docker.internal:8000
# Если Marzban в другом контейнере той же docker-сети:
# MARZBAN_URL=http://<marzban_service_name>:8000
# Если Marzban работает по HTTPS с self-signed сертификатом:
# MARZBAN_URL=https://<host_or_service>:8000
# MARZBAN_INSECURE_TLS=true
# Если в логине/пароле есть спецсимволы (#, &, !, *), указывайте в кавычках
# Пример:
# MARZBAN_USERNAME="G72#nT..."
# MARZBAN_PASSWORD="v8#R&k29!PzQ*5...."
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=your_secure_password
MARZBAN_INSECURE_TLS=true
